# Copy to .env for local development. Never commit .env.
# In production, set these in Netlify → Site configuration → Environment variables.

# --- YouTube Data API v3 (Google Cloud Console → APIs & Services → Credentials) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UC6REYc9lkrj8Em4kjCYsG7A

# --- Database ---
# Production: Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
# Local dev without Supabase: pglite:./.data/db  (a real Postgres stored in a local folder)
DATABASE_URL=pglite:./.data/db

# --- Media storage (Supabase → Project Settings → API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# --- Admin auth ---
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Used by `npm run admin:create` to create the single admin account
ADMIN_EMAIL=

# --- Site ---
# Public URL, used for canonical links, sitemap and Open Graph
SITE_URL=http://localhost:8888
# Protects the scheduled sync endpoint when triggered manually outside Netlify
SYNC_SECRET=

{
  "name": "dephantom-tamil-site",
  "version": "0.1.0",
  "private": true,
  "description": "Official website + CMS for the DePhantom தமிழ் YouTube channel",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "netlify dev",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env scripts/db.js migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/db.js seed",
    "db:setup": "node --env-file-if-exists=.env scripts/db.js setup",
    "db:status": "node --env-file-if-exists=.env scripts/db.js status",
    "db:local": "node scripts/local-db.js",
    "sync": "node --env-file-if-exists=.env scripts/sync.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@electric-sql/pglite-socket": "^0.0.22",
    "netlify-cli": "^27.12.1",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-tamil": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "postgres": "^3.4.9"
  }
}
